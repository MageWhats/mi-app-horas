# Copia este archivo como .env (o .env.local) y complétalo. Las mismas variables van en Vercel y en EAS.

# Supabase (Dashboard → Project Settings → API). Nunca uses aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# CAPTCHA (opcional). Site Key pública de Cloudflare Turnstile; la Secret Key va en el Vault de Supabase.
# Ver supabase/README.md → CAPTCHA.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# URL pública de la app web (sin barra al final). Android/iOS abren desde ahí la verificación anti-bots.
EXPO_PUBLIC_SITE_URL=https://tu-app.vercel.app
